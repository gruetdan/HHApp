<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="303.0" prefWidth="247.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.zhaw.hhapp.controller.ExpensesController">
   <children>
      <Button fx:id="addExpenseListButton" layoutX="167.0" layoutY="55.0" mnemonicParsing="false" onAction="#addExpenseList" text="Edit list" />
      <TextField fx:id="expenseListTextField" layoutX="22.0" layoutY="55.0" prefHeight="25.0" prefWidth="139.0" promptText="Expense List name" />
      <Label alignment="CENTER" layoutX="19.0" layoutY="14.0" prefHeight="17.0" prefWidth="148.0" text="Name of an existing or new" />
      <ListView fx:id="expensesListView" layoutX="22.0" layoutY="115.0" prefHeight="146.0" prefWidth="201.0" />
      <Label alignment="CENTER" layoutX="19.0" layoutY="31.0" text="(see below) expense list" />
      <Label alignment="CENTER" layoutX="20.0" layoutY="98.0" text="Existing expense liste(s)" />
      <Button fx:id="showSumButton" layoutX="22.0" layoutY="245.0" mnemonicParsing="false" onAction="#handleShowSum" text="Show sum" AnchorPane.bottomAnchor="10.0" />
      <Button fx:id="deleteExpensesListButton" layoutX="154.0" layoutY="267.0" mnemonicParsing="false" onAction="#handleDeleteExpensesList" text="Delete List" />   </children>
</AnchorPane>
